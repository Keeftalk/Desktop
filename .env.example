# ==============================================================================
# Keeftalk Desktop - Environment Variables Template
# ==============================================================================
# Copy to `.env` for local development. NEVER commit `.env` to Git.
# Leave SUPABASE_* blank or set KEEFTALK_MOCK_MODE=true to run offline demo mode.

# --- Runtime Mode ---
# "mock" | "offline" | "cloud"
KEEFTALK_MODE=mock

# --- Backend Configuration (Public client settings only; NEVER put service_role keys here) ---
KEEFTALK_SUPABASE_URL=https://your-supabase-project.supabase.co
KEEFTALK_SUPABASE_ANON_KEY=your_public_supabase_anon_key

# --- Logging ---
RUST_LOG=info,keeftalk=debug

# --- Optional Custom Data Directory ---
# KEEFTALK_DATA_DIR=/path/to/custom/keeftalk-data
